# Exclude everything
/*

# Except for default project files
!/.github
!/build-aux
!/cmake
!/data
!/docs
!/models
!/pages
!/scripts
!/src
!/vcpkg-triplets
!/standalone
!/microsoft.ml.onnxruntime.directml.*
!/microsoft.ai.directml.*
!.clang-format
!.cmake-format.json
!.gersemirc
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!FAQ.md
!LICENSE
!README.md
!vcpkg-configuration.json
!vcpkg.json

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber

src/*.generated.*

# Standalone: track sources, exclude build artifacts and model binaries
/standalone/build/
/standalone/models/

